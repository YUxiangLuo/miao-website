<style is:global>
:root{
  --bg:#0b0d10;
  --pane:#0e1116;
  --line:#1c222b;
  --ink:#e8edf2;
  --body:#9aa7b4;
  --dim:#5b6672;
  --accent:#8fb8e8;
  --ok:#4a9e75;
  --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Noto Sans CJK SC","Microsoft YaHei",sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{
  background:var(--bg);color:var(--body);
  font:15px/1.75 var(--sans);
  -webkit-font-smoothing:antialiased;
}
::selection{background:var(--accent);color:var(--bg)}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
code,pre,.m{font-family:var(--mono)}
.wrap{max-width:880px;margin:0 auto;padding:0 24px}

/* ── header ─────────────────────────────── */
header{
  position:sticky;top:0;z-index:10;
  background:var(--bg);border-bottom:1px solid var(--line);
}
header .wrap{display:flex;align-items:center;gap:10px;height:52px}
header svg{display:block}
.brand{font:700 15px var(--mono);color:var(--ink)}
.brand .v{font:400 12px var(--mono);color:var(--dim);margin-left:8px}
nav{margin-left:auto;display:flex;align-items:center;gap:20px;font:12.5px var(--mono)}
nav a{line-height:1}
nav a{color:var(--dim)}
nav a:hover{color:var(--ink);text-decoration:none}
nav a.gh{color:var(--body)}

/* ── hero ───────────────────────────────── */
.hero{padding:88px 0 64px}
.eyebrow{font:12.5px var(--mono);color:var(--dim);margin-bottom:18px}
.eyebrow b{color:var(--ok);font-weight:400}
h1{
  font:700 40px/1.3 var(--sans);color:var(--ink);letter-spacing:.01em;
  margin-bottom:16px;
}
.lede{max-width:640px;margin-bottom:40px}
.lede code{font-size:13.5px;color:var(--ink);background:var(--pane);border:1px solid var(--line);padding:1px 5px;border-radius:2px}

/* terminal pane */
.pane{
  background:var(--pane);border:1px solid var(--line);border-radius:2px;
  margin-bottom:14px;
}
.pane-head{
  display:flex;align-items:center;gap:12px;
  padding:7px 12px;border-bottom:1px solid var(--line);
  font:12px var(--mono);color:var(--dim);
}
.pane-head .path{margin-right:auto}
.pane-head button{
  font:12px var(--mono);color:var(--dim);background:none;border:none;cursor:pointer;padding:2px 4px;
}
.pane-head button:hover{color:var(--ink)}
.tabs{display:flex;gap:2px;margin-bottom:-1px;position:relative;z-index:1}
.tabs button{
  font:12px var(--mono);color:var(--dim);background:none;cursor:pointer;
  border:1px solid transparent;border-bottom:none;border-radius:2px 2px 0 0;
  padding:6px 12px;
}
.tabs button:hover{color:var(--body)}
.tabs button[aria-selected="true"]{
  color:var(--accent);background:var(--pane);border-color:var(--line);
}
.pane pre{
  padding:16px;overflow-x:auto;
  font:13px/1.9 var(--mono);color:var(--body);
  scrollbar-width:thin;scrollbar-color:var(--line) transparent;
}
.l{white-space:pre}
.l.cmd{color:var(--ink)}
.l.cmd::before{content:"$ ";color:var(--dim)}
.l.cmd.ps::before{content:"> "}
.l.cmt{color:var(--dim)}
.l .ok{color:var(--ok)}
.l a{color:var(--accent)}
.caret{display:inline-block;width:8px;height:15px;background:var(--accent);vertical-align:-2px;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
@media (prefers-reduced-motion:reduce){.caret{animation:none}}

.meta-row{font:12.5px var(--mono);color:var(--dim);display:flex;flex-wrap:wrap;gap:8px 20px}
.meta-row a{color:var(--body)}

/* ── sections ───────────────────────────── */
section{padding:56px 0}
.rule{display:flex;align-items:center;gap:14px;margin-bottom:36px;font:13px var(--mono);color:var(--dim)}
.rule::before{content:"";width:28px;height:1px;background:var(--line)}
.rule::after{content:"";flex:1;height:1px;background:var(--line)}
.rule b{color:var(--body);font-weight:500}

figure img{
  display:block;width:100%;height:auto;
  border:1px solid var(--line);border-radius:2px;
}
figcaption{font:12px var(--mono);color:var(--dim);margin-top:10px;text-align:right}

/* spec-sheet definition list */
dl{border-top:1px solid var(--line)}
dl>div{
  display:grid;grid-template-columns:220px 1fr;gap:8px 28px;
  padding:13px 2px;border-bottom:1px solid var(--line);
}
dt{font:13px var(--mono);color:var(--ink)}
dd{font-size:14.5px}
dd code{font-size:12.5px;color:var(--ink);background:var(--pane);border:1px solid var(--line);padding:0 4px;border-radius:2px}

/* architecture flow diagram (CSS 发丝框,替代 CJK ASCII 图——盒画字符在 Web 字体下无法保证对齐) */
.scroll{overflow-x:auto}
.flow{display:flex;align-items:stretch;min-width:660px;padding:22px 16px;font-family:var(--mono)}
.fbox{
  border:1px solid var(--line);border-radius:2px;padding:12px 16px;
  color:var(--ink);font-size:12.5px;line-height:1.6;
  display:flex;flex-direction:column;justify-content:center;
}
.fbox small{color:var(--dim);font-size:11.5px;margin-top:6px;line-height:1.7}
.flink{flex:1;min-width:96px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;padding:0 4px}
.flabel{font-size:11.5px;color:var(--accent);text-align:center;line-height:1.6}
.flink.bi .flabel{color:var(--ok)}
.farrow{align-self:stretch;height:1px;background:var(--dim);position:relative}
.farrow::after{content:"";position:absolute;right:-1px;top:-3.5px;border:4px solid transparent;border-left-color:var(--dim);border-right:0}
.farrow.both::before{content:"";position:absolute;left:-1px;top:-3.5px;border:4px solid transparent;border-right-color:var(--dim);border-left:0}

ul.facts{list-style:none;margin-top:22px}
ul.facts li{padding-left:18px;position:relative;margin-bottom:6px;font-size:14.5px}
ul.facts li::before{content:"-";position:absolute;left:2px;color:var(--dim)}
ul.facts code{font-size:12.5px;color:var(--ink);background:var(--pane);border:1px solid var(--line);padding:0 4px;border-radius:2px}

/* tables */
table{width:100%;border-collapse:collapse;font-size:14px;margin-bottom:28px}
th{font:500 12px var(--mono);color:var(--dim);text-align:left;padding:8px 12px 8px 2px;border-bottom:1px solid var(--line)}
td{padding:11px 12px 11px 2px;border-bottom:1px solid var(--line);vertical-align:top}
td.m,td a{font-family:var(--mono);font-size:12.5px}
td:first-child{color:var(--ink);white-space:nowrap}
.philo td:first-child{font:12.5px var(--mono);color:var(--dim)}
.philo td:last-child{color:var(--ink)}

/* faq */
details{border-bottom:1px solid var(--line)}
details:first-of-type{border-top:1px solid var(--line)}
summary{
  cursor:pointer;list-style:none;padding:14px 2px;
  color:var(--ink);font-size:14.5px;position:relative;padding-left:20px;
}
summary::before{content:">";position:absolute;left:2px;font-family:var(--mono);color:var(--dim);font-size:13px}
details[open] summary::before{content:"v"}
details p{padding:0 2px 16px 20px;font-size:14.5px;max-width:720px}
details code{font-size:12.5px;color:var(--ink);background:var(--pane);border:1px solid var(--line);padding:0 4px;border-radius:2px}

/* footer */
footer{
  border-top:1px solid var(--line);margin-top:48px;
  padding:22px 0 34px;font:12px var(--mono);color:var(--dim);
}
footer .wrap{display:flex;gap:8px 24px;flex-wrap:wrap}
footer .man{margin-right:auto}
footer a{color:var(--dim)}
footer a:hover{color:var(--ink)}

@media (max-width:640px){
  nav a:not(.gh){display:none}
  .hero{padding:56px 0 40px}
  h1{font-size:28px}
  dl>div{grid-template-columns:1fr;gap:2px;padding:12px 2px}
  .pane pre{font-size:12px}
  section{padding:40px 0}
}
</style>
</head>
