<script is:inline>
(function(){
  "use strict";
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ── copy ── */
  document.querySelectorAll(".pane .copy").forEach(function(btn){
    btn.addEventListener("click", function(){
      var pane = btn.closest(".pane");
      var text = pane.getAttribute("data-copy") || "";
      navigator.clipboard.writeText(text).then(function(){
        var old = btn.textContent;
        btn.textContent = "✓ 已复制";
        setTimeout(function(){ btn.textContent = old; }, 1200);
      });
    });
  });

  /* ── typing replay ── */
  var CMD_MS = 16, OUT_MS = 140;

  function play(pane){
    var pre = pane.querySelector("pre");
    var lines = Array.prototype.slice.call(pre.querySelectorAll(".l"));
    lines.forEach(function(l){ l.style.visibility = "hidden"; });
    var caret = document.createElement("span");
    caret.className = "caret";
    var i = 0;
    function next(){
      if(i >= lines.length){ caret.remove(); return; }
      var l = lines[i++];
      l.style.visibility = "";
      if(l.classList.contains("cmd")){
        var text = l.textContent;
        var j = 0;
        l.textContent = "";
        l.appendChild(caret);
        (function tick(){
          if(reduce){ j = text.length; }
          else { j += 1 + Math.floor(Math.random()*2); }
          if(j >= text.length){
            l.textContent = text;
            setTimeout(next, OUT_MS);
          }else{
            l.textContent = text.slice(0, j);
            l.appendChild(caret);
            setTimeout(tick, CMD_MS);
          }
        })();
      }else{
        setTimeout(next, reduce ? 0 : OUT_MS);
      }
    }
    next();
  }

  document.querySelectorAll(".pane .replay").forEach(function(btn){
    btn.addEventListener("click", function(){ play(btn.closest(".pane")); });
  });

  /* ── platform tabs ── */
  var tabs = Array.prototype.slice.call(document.querySelectorAll(".tabs button"));
  var panes = {
    "linux-amd64": document.getElementById("term-linux-amd64"),
    "linux-arm64": document.getElementById("term-linux-arm64"),
    "windows":     document.getElementById("term-windows")
  };
  tabs.forEach(function(tab){
    tab.addEventListener("click", function(){
      tabs.forEach(function(t){ t.setAttribute("aria-selected", String(t === tab)); });
      Object.keys(panes).forEach(function(k){ panes[k].hidden = true; });
      var pane = panes[tab.dataset.t];
      pane.hidden = false;
      if(pane.querySelector(".replay")) play(pane);
    });
  });

  /* auto-play once when hero enters view */
  if(!reduce){
    var first = panes["linux-amd64"];
    if("IntersectionObserver" in window){
      var io = new IntersectionObserver(function(es){
        es.forEach(function(e){ if(e.isIntersecting){ play(first); io.disconnect(); } });
      }, {threshold:.4});
      io.observe(first);
    }else{
      play(first);
    }
  }
})();
</script>
